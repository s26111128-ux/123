<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>雲端心電感應 (多人默契遊戲)</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts: Inter & Noto Sans TC -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+TC:wght@400;500;700&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        morandi: {
                            bg: '#F4F1EA',          // 柔和米白背景
                            card: '#FFFFFF',        // 純白卡片
                            cardBack: '#E6E1DA',    // 未開牌卡背色
                            text: '#4A4A4A',        // 主文字灰
                            subtext: '#7F8C8D',     // 次要文字灰
                            sage: '#8B9B90',        // 鼠尾草綠 (主按鈕/品牌色)
                            sageHover: '#77887D',   // 鼠尾草綠 Hover
                            terracotta: '#C79288',  // 赤陶粉 (開牌/重點)
                            terracottaHover: '#B57F75',
                            taupe: '#B5A89B',       // 溫暖灰褐 (輔助)
                            border: '#E2DDD5'       // 極簡邊框色
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'Noto Sans TC', 'sans-serif'],
                    }
                }
            }
        }
    </script>

    <style>
        body {
            background-color: #F4F1EA;
            color: #4A4A4A;
            font-family: 'Inter', 'Noto Sans TC', sans-serif;
            min-height: 100vh;
        }

        /* 3D CSS 翻牌關鍵樣式 */
        .card-container {
            perspective: 1000px;
        }
        
        .card-inner {
            position: relative;
            width: 100%;
            height: 100%;
            transition: transform 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            transform-style: preserve-3d;
        }
        
        .card-inner.flipped {
            transform: rotateY(180deg);
        }
        
        .card-front, .card-back {
            position: absolute;
            width: 100%;
            height: 100%;
            -webkit-backface-visibility: hidden;
            backface-visibility: hidden;
            border-radius: 1rem;
        }
        
        /* 正面 (未開牌時看到的背面視角，顯示玩家名稱與鎖頭) */
        .card-front {
            transform: rotateY(0deg);
        }
        
        /* 背面 (開牌後翻轉過來的視角，顯示答案) */
        .card-back {
            transform: rotateY(180deg);
        }

        /* Notion 極簡風格陰影與細邊框 */
        .notion-box {
            background: #FFFFFF;
            border: 1px solid #E2DDD5;
            box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.03), 0 2px 6px -1px rgba(0, 0, 0, 0.02);
        }

        .notion-input {
            background: #F9F8F6;
            border: 1px solid #E2DDD5;
            transition: all 0.2s ease;
        }

        .notion-input:focus {
            outline: none;
            border-color: #8B9B90;
            background: #FFFFFF;
            box-shadow: 0 0 0 3px rgba(139, 155, 144, 0.15);
        }

        /* 自訂 Drawer 動畫 */
        .drawer-overlay {
            transition: opacity 0.3s ease;
        }
        .drawer-content {
            transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        }
    </style>
</head>
<body class="flex flex-col min-h-screen">

    <!-- 頂部導覽列 Header -->
    <header class="w-full border-b border-morandi-border bg-white/80 backdrop-blur-md sticky top-0 z-30">
        <div class="max-w-5xl mx-auto px-4 py-3.5 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <div class="w-8 h-8 rounded-lg bg-morandi-sage text-white flex items-center justify-center font-bold text-lg shadow-sm">
                    ✨
                </div>
                <div>
                    <h1 class="font-bold text-morandi-text text-base md:text-lg tracking-tight">雲端心電感應</h1>
                    <p class="text-xs text-morandi-subtext font-medium hidden sm:block">多人默契考驗遊戲</p>
                </div>
            </div>

            <!-- 房間資訊標籤 (登入後顯示) -->
            <div id="roomBadge" class="hidden flex items-center space-x-2 bg-morandi-bg px-3 py-1.5 rounded-full border border-morandi-border text-xs md:text-sm font-medium">
                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                <span>房號: <strong id="displayRoomId" class="text-morandi-text font-bold">----</strong></span>
                <span class="text-morandi-border">|</span>
                <span>玩家: <strong id="displayName" class="text-morandi-sage">----</strong></span>
                <button onclick="leaveRoom()" class="ml-2 text-morandi-subtext hover:text-rose-500 transition-colors" title="離開房間">
                    <i class="fa-solid fa-right-from-bracket"></i>
                </button>
            </div>
        </div>
    </header>

    <!-- 主要內容區塊 -->
    <main class="flex-grow max-w-5xl w-full mx-auto p-4 md:p-6 flex flex-col justify-center items-center">

        <!-- 視圖 1: 登入 / 建立房間視圖 (Login Section) -->
        <section id="loginSection" class="w-full max-w-md my-auto">
            <div class="notion-box rounded-2xl p-6 md:p-8 space-y-6">
                <div class="text-center space-y-2">
                    <h2 class="text-2xl font-bold text-morandi-text tracking-tight">開始默契挑戰</h2>
                    <p class="text-sm text-morandi-subtext">請輸入您的暱稱與房間代碼以加入或創建房間</p>
                </div>

                <div class="space-y-4">
                    <div>
                        <label class="block text-xs font-semibold text-morandi-subtext uppercase tracking-wider mb-1.5">您的暱稱</label>
                        <input type="text" id="playerNameInput" placeholder="例如：心靈小幫手" class="w-full notion-input px-4 py-3 rounded-xl text-morandi-text placeholder-gray-400 text-sm">
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-morandi-subtext uppercase tracking-wider mb-1.5">房間號碼 (Room ID)</label>
                        <div class="flex space-x-2">
                            <input type="text" id="roomIdInput" placeholder="例如：1234" maxlength="10" class="w-full notion-input px-4 py-3 rounded-xl text-morandi-text placeholder-gray-400 text-sm uppercase tracking-widest font-mono">
                            <button type="button" onclick="generateRandomRoom()" class="px-3 py-3 bg-morandi-bg hover:bg-morandi-border text-morandi-text rounded-xl border border-morandi-border text-xs font-semibold whitespace-nowrap transition-colors" title="隨機生成號碼">
                                <i class="fa-solid fa-dice mr-1"></i> 隨機
                            </button>
                        </div>
                    </div>

                    <button onclick="joinRoom()" class="w-full py-3.5 bg-morandi-sage hover:bg-morandi-sageHover text-white font-medium rounded-xl shadow-sm transition-all duration-200 flex items-center justify-center space-x-2 text-sm">
                        <span>進入心電感應空間</span>
                        <i class="fa-solid fa-arrow-right text-xs"></i>
                    </button>
                </div>
            </div>
        </section>

        <!-- 視圖 2: 遊戲主要面板 (Game Section) -->
        <section id="gameSection" class="w-full hidden space-y-6">
            
            <!-- 頂部題目區塊 (Question Header) -->
            <div class="notion-box rounded-2xl p-6 md:p-8 text-center space-y-3 relative overflow-hidden">
                <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-morandi-bg text-morandi-subtext text-xs font-semibold tracking-wider uppercase">
                    <span id="gameStatusBadge">等待房主出題...</span>
                </div>
                <h2 id="questionDisplay" class="text-xl md:text-3xl font-bold text-morandi-text tracking-tight min-h-[2.5rem] flex items-center justify-center">
                    請等待房主出題！
                </h2>
                <p id="subStatusText" class="text-xs md:text-sm text-morandi-subtext">輪詢同步中 (3s)</p>
            </div>

            <!-- 玩家填答區塊 (僅在 status === 'playing' 顯示) -->
            <div id="answerInputBlock" class="notion-box rounded-2xl p-6 hidden">
                <div class="max-w-xl mx-auto flex flex-col sm:flex-row gap-3">
                    <input type="text" id="myAnswerInput" placeholder="輸入您的心靈答案..." class="w-full notion-input px-4 py-3 rounded-xl text-morandi-text text-sm">
                    <button onclick="submitAnswer()" class="w-full sm:w-auto px-6 py-3 bg-morandi-sage hover:bg-morandi-sageHover text-white font-medium rounded-xl whitespace-nowrap text-sm shadow-sm transition-colors flex items-center justify-center space-x-2">
                        <i class="fa-solid fa-paper-plane text-xs"></i>
                        <span>送出答案</span>
                    </button>
                </div>
            </div>

            <!-- 全體玩家答案卡片網格 (Cards Grid) -->
            <div class="space-y-3">
                <div class="flex items-center justify-between px-1">
                    <h3 class="text-sm font-semibold text-morandi-subtext tracking-wider uppercase">全體玩家卡片 (<span id="playerCount">0</span>)</h3>
                    <div id="syncIndicator" class="text-xs text-morandi-subtext flex items-center space-x-1 opacity-60">
                        <i class="fa-solid fa-arrows-rotate text-[10px] animate-spin"></i>
                        <span>即時連線中</span>
                    </div>
                </div>

                <!-- 卡片集容器 -->
                <div id="cardsGrid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
                    <!-- 動態渲染卡片放置於此 -->
                </div>
            </div>

        </section>

    </main>

    <!-- 右下角隱藏式房主控制台按鈕 -->
    <button id="hostConsoleToggleBtn" onclick="toggleDrawer(true)" class="hidden fixed bottom-6 right-6 w-12 h-12 bg-morandi-taupe hover:bg-morandi-text text-white rounded-full shadow-lg items-center justify-center transition-all duration-300 z-40 group hover:scale-105" title="隱藏房主控制台">
        <i class="fa-solid fa-key text-lg group-hover:rotate-45 transition-transform duration-300"></i>
    </button>

    <!-- 房主控制台 Drawer (抽屜面板) -->
    <div id="drawerOverlay" class="drawer-overlay fixed inset-0 bg-black/30 backdrop-blur-sm z-50 opacity-0 pointer-events-none" onclick="toggleDrawer(false)"></div>
    
    <div id="drawerContent" class="drawer-content fixed top-0 right-0 h-full w-full max-w-md bg-white shadow-2xl z-50 transform translate-x-full flex flex-col">
        <!-- Drawer Header -->
        <div class="p-5 border-b border-morandi-border flex items-center justify-between bg-morandi-bg">
            <div class="flex items-center space-x-2">
                <i class="fa-solid fa-user-gear text-morandi-sage text-lg"></i>
                <h3 class="font-bold text-morandi-text">隱藏房主控制台</h3>
            </div>
            <button onclick="toggleDrawer(false)" class="text-morandi-subtext hover:text-morandi-text p-1">
                <i class="fa-solid fa-xmark text-lg"></i>
            </button>
        </div>

        <!-- Drawer Body -->
        <div class="p-6 flex-grow space-y-6 overflow-y-auto">
            <!-- 1. 設定新題目 -->
            <div class="space-y-3">
                <label class="block text-xs font-bold text-morandi-subtext uppercase tracking-wider">步驟 1：設定題目並發布</label>
                <div class="space-y-2">
                    <textarea id="hostQuestionInput" rows="3" placeholder="例如：說到夏天會聯想到的水果？" class="w-full notion-input p-3 rounded-xl text-sm text-morandi-text"></textarea>
                    <button onclick="hostSetQuestion()" class="w-full py-2.5 bg-morandi-sage hover:bg-morandi-sageHover text-white font-medium rounded-xl text-sm transition-colors shadow-sm flex items-center justify-center space-x-2">
                        <i class="fa-solid fa-bullhorn text-xs"></i>
                        <span>發布題目 (開啟回答)</span>
                    </button>
                </div>
            </div>

            <hr class="border-morandi-border">

            <!-- 2. 開牌觸發 -->
            <div class="space-y-3">
                <label class="block text-xs font-bold text-morandi-subtext uppercase tracking-wider">步驟 2：同步開牌</label>
                <p class="text-xs text-morandi-subtext">按下開牌後，所有連線中的玩家網頁將會同步觸發 3D 卡片翻轉動畫！</p>
                <button onclick="hostReveal()" class="w-full py-3 bg-morandi-terracotta hover:bg-morandi-terracottaHover text-white font-bold rounded-xl text-sm transition-colors shadow-sm flex items-center justify-center space-x-2">
                    <i class="fa-solid fa-wand-magic-sparkles"></i>
                    <span>全體 3D 同步開牌</span>
                </button>
            </div>

            <hr class="border-morandi-border">

            <!-- 3. 重置房間 -->
            <div class="space-y-3 pt-2">
                <label class="block text-xs font-bold text-morandi-subtext uppercase tracking-wider">步驟 3：重置遊戲</label>
                <button onclick="hostReset()" class="w-full py-2.5 border border-rose-200 text-rose-600 hover:bg-rose-50 font-medium rounded-xl text-sm transition-colors flex items-center justify-center space-x-2">
                    <i class="fa-solid fa-rotate-right text-xs"></i>
                    <span>重置房間為初始狀態</span>
                </button>
            </div>
        </div>

        <!-- Drawer Footer -->
        <div class="p-4 border-t border-morandi-border bg-morandi-bg text-center text-xs text-morandi-subtext">
            目前的房號：<span id="drawerRoomId" class="font-bold text-morandi-text">----</span>
        </div>
    </div>

    <!-- 自訂 Notification Toast (代替 alert) -->
    <div id="toast" class="fixed top-5 right-5 transform translate-y-[-150%] transition-transform duration-300 z-50 bg-morandi-text text-white px-4 py-3 rounded-xl shadow-xl flex items-center space-x-3 text-sm">
        <i id="toastIcon" class="fa-solid fa-circle-info text-morandi-sage"></i>
        <span id="toastMessage">提示訊息</span>
    </div>

    <!-- JavaScript Logic -->
    <script>
        // 設定常數與 API
        const SHEET_NAME = 'TelepathyData';
        const GAS_API_URL = "https://script.google.com/macros/s/AKfycbwpczbfXbl5eWMiuJeMxBFjP-1bLnT2vXHBUAks16cFXNXt_V2OPFxOvFaAUrW5l1F_Ng/exec";
        
        // 狀態變數
        let currentRoom = "";
        let playerName = "";
        let pollingInterval = null;
        let lastRoomState = null; // 紀錄前一次狀態以判斷狀態切換

        // 初始化
        window.onload = () => {
            // 自動從網址列擷取 room 參數 (若有)
            const urlParams = new URLSearchParams(window.location.search);
            const roomParam = urlParams.get('room');
            if (roomParam) {
                document.getElementById('roomIdInput').value = roomParam;
            }
        };

        // 隨機生成 4 位數房號
        function generateRandomRoom() {
            const randomCode = Math.floor(1000 + Math.random() * 9000).toString();
            document.getElementById('roomIdInput').value = randomCode;
        }

        // 進入房間
        function joinRoom() {
            const name = document.getElementById('playerNameInput').value.trim();
            const room = document.getElementById('roomIdInput').value.trim();

            if (!name) {
                showToast("請輸入您的暱稱！", "warning");
                return;
            }
            if (!room) {
                showToast("請輸入或生成房間代碼！", "warning");
                return;
            }

            playerName = name;
            currentRoom = room;

            // 更新 UI
            document.getElementById('displayName').innerText = playerName;
            document.getElementById('displayRoomId').innerText = currentRoom;
            document.getElementById('drawerRoomId').innerText = currentRoom;

            document.getElementById('loginSection').classList.add('hidden');
            document.getElementById('gameSection').classList.remove('hidden');
            document.getElementById('roomBadge').classList.remove('hidden');
            document.getElementById('roomBadge').classList.add('flex');
            document.getElementById('hostConsoleToggleBtn').classList.remove('hidden');
            document.getElementById('hostConsoleToggleBtn').classList.add('flex');

            // 啟動 3 秒輪詢
            fetchRoomData();
            if (pollingInterval) clearInterval(pollingInterval);
            pollingInterval = setInterval(fetchRoomData, 3000);

            showToast(`已成功進入房間 #${currentRoom}`, "success");
        }

        // 離開房間
        function leaveRoom() {
            if (pollingInterval) clearInterval(pollingInterval);
            currentRoom = "";
            playerName = "";
            lastRoomState = null;

            document.getElementById('loginSection').classList.remove('hidden');
            document.getElementById('gameSection').classList.add('hidden');
            document.getElementById('roomBadge').classList.add('hidden');
            document.getElementById('hostConsoleToggleBtn').classList.add('hidden');
            toggleDrawer(false);

            showToast("已離開房間", "info");
        }

        // 輪詢 API GET 抓取資料
        async function fetchRoomData() {
            if (!currentRoom) return;

            const syncIcon = document.getElementById('syncIndicator');
            syncIcon.classList.remove('opacity-0');

            try {
                const response = await fetch(`${GAS_API_URL}?room=${encodeURIComponent(currentRoom)}`);
                const data = await response.json();
                renderGameState(data);
            } catch (error) {
                console.error("Fetch error:", error);
            } finally {
                setTimeout(() => {
                    syncIcon.classList.add('opacity-0');
                }, 800);
            }
        }

        // 渲染遊戲狀態
        function renderGameState(data) {
            const { status, question, answers } = data;

            const questionDisplay = document.getElementById('questionDisplay');
            const gameStatusBadge = document.getElementById('gameStatusBadge');
            const answerInputBlock = document.getElementById('answerInputBlock');
            const subStatusText = document.getElementById('subStatusText');

            // 階段一: setup (準備階段)
            if (status === 'setup') {
                questionDisplay.innerText = "等待房主出題...";
                gameStatusBadge.innerText = "準備階段 (SETUP)";
                gameStatusBadge.className = "inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-morandi-bg text-morandi-subtext text-xs font-semibold tracking-wider uppercase";
                answerInputBlock.classList.add('hidden');
                subStatusText.innerText = "房主正在出題中，請稍候...";
            } 
            // 階段二: playing (回答階段)
            else if (status === 'playing') {
                questionDisplay.innerText = question || "房主尚未設定題目";
                gameStatusBadge.innerText = "回答中 (PLAYING)";
                gameStatusBadge.className = "inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-amber-100 text-amber-700 text-xs font-semibold tracking-wider uppercase";
                answerInputBlock.classList.remove('hidden');
                subStatusText.innerText = "請在下方填寫您的心靈答案，填寫完成後請等待房主開牌！";
            } 
            // 階段三: revealed (開牌揭曉階段)
            else if (status === 'revealed') {
                questionDisplay.innerText = question || "題目揭曉";
                gameStatusBadge.innerText = "已開牌 (REVEALED)";
                gameStatusBadge.className = "inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-emerald-100 text-emerald-700 text-xs font-semibold tracking-wider uppercase";
                answerInputBlock.classList.add('hidden');
                subStatusText.innerText = "答案已揭曉！來看看大家的默契指數高不高！";
            }

            // 渲染玩家答案卡片
            renderCards(answers, status === 'revealed');

            // 當狀態剛切換到 revealed 時觸發開牌提示
            if (lastRoomState && lastRoomState !== 'revealed' && status === 'revealed') {
                showToast("✨ 房主已開牌！解答揭曉中！", "success");
            }
            lastRoomState = status;
        }

        // 渲染 3D 翻牌卡片
        function renderCards(answers, isRevealed) {
            const cardsGrid = document.getElementById('cardsGrid');
            const playerNames = Object.keys(answers || {});
            document.getElementById('playerCount').innerText = playerNames.length;

            if (playerNames.length === 0) {
                cardsGrid.innerHTML = `
                    <div class="col-span-full notion-box rounded-2xl p-8 text-center text-morandi-subtext text-sm">
                        目前尚無玩家送出答案...
                    </div>
                `;
                return;
            }

            // 建立或更新卡片 DOM
            let html = '';
            playerNames.forEach(name => {
                const answer = answers[name];
                const isFlippedClass = isRevealed ? 'flipped' : '';

                html += `
                    <div class="card-container h-44 w-full">
                        <div class="card-inner ${isFlippedClass}">
                            <!-- 正面 (未開牌時看到的背面視角: 顯示姓名與鎖頭) -->
                            <div class="card-front notion-box p-5 flex flex-col justify-between items-center text-center border border-morandi-border bg-gradient-to-br from-white to-morandi-bg">
                                <div class="w-full flex justify-between items-center text-xs text-morandi-subtext font-medium">
                                    <span class="truncate max-w-[120px] font-bold text-morandi-text">${escapeHtml(name)}</span>
                                    <span class="px-2 py-0.5 rounded-full bg-morandi-cardBack text-morandi-text text-[10px]">已送出</span>
                                </div>
                                
                                <div class="my-auto flex flex-col items-center justify-center space-y-2">
                                    <div class="w-10 h-10 rounded-full bg-morandi-bg flex items-center justify-center text-morandi-taupe border border-morandi-border">
                                        <i class="fa-solid fa-lock"></i>
                                    </div>
                                    <p class="text-xs text-morandi-subtext font-medium">等待開牌揭曉</p>
                                </div>

                                <div class="w-full text-center text-[10px] text-morandi-subtext tracking-widest uppercase">
                                    TELEPATHY CARD
                                </div>
                            </div>

                            <!-- 背面 (開牌後 3D 翻轉呈現: 揭曉答案) -->
                            <div class="card-back notion-box p-5 flex flex-col justify-between items-center text-center border-2 border-morandi-sage bg-white">
                                <div class="w-full flex justify-between items-center text-xs text-morandi-subtext font-medium">
                                    <span class="truncate max-w-[120px] font-bold text-morandi-sage">${escapeHtml(name)}</span>
                                    <i class="fa-solid fa-sparkles text-amber-400"></i>
                                </div>

                                <div class="my-auto px-2">
                                    <p class="text-lg md:text-xl font-bold text-morandi-text break-all">
                                        "${escapeHtml(answer)}"
                                    </p>
                                </div>

                                <div class="w-full text-center text-[10px] text-morandi-sage font-bold tracking-widest uppercase">
                                    ANSWER REVEALED
                                </div>
                            </div>
                        </div>
                    </div>
                `;
            });

            cardsGrid.innerHTML = html;
        }

        // 玩家送出答案
        async function submitAnswer() {
            const answerInput = document.getElementById('myAnswerInput');
            const answer = answerInput.value.trim();

            if (!answer) {
                showToast("請輸入答案後再送出！", "warning");
                return;
            }

            try {
                const payload = {
                    room: currentRoom,
                    action: "submit_answer",
                    playerName: playerName,
                    answer: answer
                };

                await fetch(GAS_API_URL, {
                    method: 'POST',
                    headers: { 'Content-Type': 'text/plain;charset=utf-8' },
                    body: JSON.stringify(payload)
                });

                showToast("答案已成功送出！", "success");
                fetchRoomData(); // 立即重新抓取
            } catch (error) {
                console.error("Submit error:", error);
                showToast("送出失敗，請重試", "error");
            }
        }

        // 房主功能：發布題目
        async function hostSetQuestion() {
            const questionInput = document.getElementById('hostQuestionInput');
            const question = questionInput.value.trim();

            if (!question) {
                showToast("請輸入題目內容！", "warning");
                return;
            }

            try {
                const payload = {
                    room: currentRoom,
                    action: "set_question",
                    question: question
                };

                await fetch(GAS_API_URL, {
                    method: 'POST',
                    headers: { 'Content-Type': 'text/plain;charset=utf-8' },
                    body: JSON.stringify(payload)
                });

                showToast("題目已成功發布！", "success");
                toggleDrawer(false);
                fetchRoomData();
            } catch (error) {
                console.error("Set question error:", error);
                showToast("發布失敗，請重試", "error");
            }
        }

        // 房主功能：觸發全體開牌
        async function hostReveal() {
            try {
                const payload = {
                    room: currentRoom,
                    action: "reveal"
                };

                await fetch(GAS_API_URL, {
                    method: 'POST',
                    headers: { 'Content-Type': 'text/plain;charset=utf-8' },
                    body: JSON.stringify(payload)
                });

                showToast("已觸發開牌！", "success");
                toggleDrawer(false);
                fetchRoomData();
            } catch (error) {
                console.error("Reveal error:", error);
                showToast("開牌指令送出失敗", "error");
            }
        }

        // 房主功能：重置房間
        async function hostReset() {
            try {
                const payload = {
                    room: currentRoom,
                    action: "reset"
                };

                await fetch(GAS_API_URL, {
                    method: 'POST',
                    headers: { 'Content-Type': 'text/plain;charset=utf-8' },
                    body: JSON.stringify(payload)
                });

                document.getElementById('hostQuestionInput').value = '';
                document.getElementById('myAnswerInput').value = '';

                showToast("房間已成功重置", "info");
                toggleDrawer(false);
                fetchRoomData();
            } catch (error) {
                console.error("Reset error:", error);
                showToast("重置失敗", "error");
            }
        }

        // 開啟/關閉 隱藏房主 Drawer
        function toggleDrawer(open) {
            const overlay = document.getElementById('drawerOverlay');
            const content = document.getElementById('drawerContent');

            if (open) {
                overlay.classList.remove('pointer-events-none');
                overlay.classList.remove('opacity-0');
                overlay.classList.add('opacity-100');

                content.classList.remove('translate-x-full');
                content.classList.add('translate-x-0');
            } else {
                overlay.classList.remove('opacity-100');
                overlay.classList.add('opacity-0');
                overlay.classList.add('pointer-events-none');

                content.classList.remove('translate-x-0');
                content.classList.add('translate-x-full');
            }
        }

        // 自訂訊息通知 Toast (替代 alert)
        function showToast(message, type = "info") {
            const toast = document.getElementById('toast');
            const toastMessage = document.getElementById('toastMessage');
            const toastIcon = document.getElementById('toastIcon');

            toastMessage.innerText = message;

            if (type === "success") {
                toastIcon.className = "fa-solid fa-circle-check text-emerald-400";
            } else if (type === "warning") {
                toastIcon.className = "fa-solid fa-triangle-exclamation text-amber-400";
            } else if (type === "error") {
                toastIcon.className = "fa-solid fa-circle-xmark text-rose-400";
            } else {
                toastIcon.className = "fa-solid fa-circle-info text-morandi-sage";
            }

            toast.classList.remove('translate-y-[-150%]');
            toast.classList.add('translate-y-0');

            setTimeout(() => {
                toast.classList.remove('translate-y-0');
                toast.classList.add('translate-y-[-150%]');
            }, 3000);
        }

        // XSS 安全防護轉義
        function escapeHtml(str) {
            if (!str) return '';
            return String(str)
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");
        }
    </script>
